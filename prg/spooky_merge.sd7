(* Spooky Merge - a Seed7 circle-merge game. *)

$ include "seed7_05.s7i";
  include "spooky_merge_core.s7i";
  include "draw.s7i";
  include "keybd.s7i";
  include "time.s7i";
  include "duration.s7i";
  include "environment.s7i";
  include "stdfont14.s7i";

const color: NIGHT is color(1100, 900, 4100);
const color: NIGHT_LIGHT is color(3600, 1900, 7200);
const color: ORANGE is color(65535, 24500, 2400);
const color: GOLD is color(65535, 49000, 9000);
const color: LIME is color(27000, 65535, 13000);
const color: VIOLET is color(42000, 18000, 65535);
const color: PALE is color(56000, 53000, 65535);
const color: PINK is color(65535, 12000, 36000);
const color: INK is color(1500, 1200, 3500);
const color: TEAL is color(5000, 50000, 49000);
const color: RED is color(65535, 6000, 5000);

const array color: TIER_COLOR is [] (
    GOLD, PINK, LIME, VIOLET, PALE, color(45000, 49000, 48000),
    TEAL, color(10000, 41000, 27000), ORANGE, color(65535, 42000, 3000));
const array string: TIER_LABEL is [] (
    "Corn", "Eye", "Web", "Bat", "Ghost", "Skull", "Brew", "Pot", "Jack", "King");
const integer: KEY_AIM_STEP is 12;

var game_state: game is game_state.value;
var PRIMITIVE_WINDOW: main_window is PRIMITIVE_WINDOW.value;
var text: labels is STD_NULL;
var integer: pointer_x is 180;
var integer: last_raw_pointer is 0;
var integer: saved_best is 0;
var boolean: running is TRUE;
var boolean: started is FALSE;
var boolean: drop_pending is FALSE;
var char: command is ' ';
var time: last_time is time(NOW);
var time: current_time is time(NOW);
var duration: elapsed is duration.value;
var float: frame_time is 0.0;
var float: accumulator is 0.0;
var float: drop_x is 180.0;
var integer: index is 1;
var integer: star is 0;
var array string: startup_arguments is 0 times "";


const proc: draw_scene is func

  local
    var integer: ball_index is 1;
    var integer: ball_tier is 1;
    var integer: ball_radius is 1;
    var integer: x is 0;
    var integer: y is 0;
    var color: accent is NIGHT_LIGHT;
  begin
    clear(NIGHT);
    (* Moon and fixed stars. *)
    fcircle(306, 58, 24, GOLD);
    fcircle(317, 51, 22, NIGHT);
    for star range 1 to 9 do
      fcircle((star * 43 + 17) mod 350 + 5,
          (star * 67 + 11) mod 88 + 8, 1, PALE);
    end for;
    color(labels, PALE, NIGHT);
    setPosXY(labels, 22, 18);
    write(labels, "SPOOKY MERGE");
    setPosXY(labels, 22, 42);
    write(labels, "SCORE " <& game.score);
    setPosXY(labels, 236, 42);
    write(labels, "BEST " <& game.best_score);
    for index range 1 to TIER_COUNT do
      x := 30 + ((index - 1) mod 5) * 64;
      if index <= 5 then
        y := 105;
      else
        y := 123;
      end if;
      fcircle(x, y, 4, TIER_COLOR[index]);
      circle(x, y, 4, GOLD);
      color(labels, TIER_COLOR[index], NIGHT);
      setPosXY(labels, x + 7, y + 5);
      write(labels, TIER_LABEL[index]);
    end for;

    (* Main glass container and overflow marker. *)
    rect(18, FIELD_TOP - 2, 324, FIELD_FLOOR - FIELD_TOP + 8, VIOLET);
    rect(22, FIELD_TOP + 2, 316, FIELD_FLOOR - FIELD_TOP, NIGHT);
    lineTo(24, WARNING_LINE, 336, WARNING_LINE, PINK);
    color(labels, PINK, NIGHT);
    setPosXY(labels, 27, WARNING_LINE - 15);
    write(labels, "DANGER");

    (* Aiming guide and next fruit preview. *)
    if started and not game.game_over then
      drop_x := float(pointer_x);
      if drop_x < float(FIELD_LEFT) + radius_of(game.current_tier) then
        drop_x := float(FIELD_LEFT) + radius_of(game.current_tier);
      elsif drop_x > float(FIELD_RIGHT) - radius_of(game.current_tier) then
        drop_x := float(FIELD_RIGHT) - radius_of(game.current_tier);
      end if;
      lineTo(round(drop_x), FIELD_TOP - 3, round(drop_x), FIELD_TOP + 22, PALE);
      fcircle(round(drop_x), FIELD_TOP + 26,
          round(radius_of(game.current_tier) * 0.55), TIER_COLOR[game.current_tier]);
      color(labels, PALE, NIGHT);
      setPosXY(labels, 22, 68);
      write(labels, "DROP");
      fcircle(90, 65, round(radius_of(game.current_tier) * 0.42),
          TIER_COLOR[game.current_tier]);
      circle(90, 65, round(radius_of(game.current_tier) * 0.42), GOLD);
      color(labels, PALE, NIGHT);
      setPosXY(labels, 108, 69);
      write(labels, TIER_NAME[game.current_tier]);
      setPosXY(labels, 22, 92);
      write(labels, "NEXT");
      fcircle(90, 89, round(radius_of(game.next_tier) * 0.42),
          TIER_COLOR[game.next_tier]);
      circle(90, 89, round(radius_of(game.next_tier) * 0.42), GOLD);
      color(labels, PALE, NIGHT);
      setPosXY(labels, 108, 93);
      write(labels, TIER_NAME[game.next_tier]);
    end if;

    (* Halloween silhouettes behind the playfield. *)
    lineTo(4, 616, 356, 616, NIGHT_LIGHT);
    fcircle(8, 623, 27, INK);
    fcircle(351, 625, 31, INK);
    lineTo(18, 615, 30, 588, INK);
    lineTo(30, 588, 43, 615, INK);
    lineTo(43, 615, 55, 591, INK);
    lineTo(55, 591, 68, 615, INK);
    lineTo(314, 617, 325, 590, INK);
    lineTo(325, 590, 338, 618, INK);

    for ball_index range 1 to MAX_OBJECTS do
      if game.balls[ball_index].active then
        ball_tier := game.balls[ball_index].tier;
        x := round(game.balls[ball_index].x);
        y := round(game.balls[ball_index].y);
        ball_radius := round(radius_of(ball_tier));
        accent := TIER_COLOR[ball_tier];
        fcircle(x, y, ball_radius, accent);
        circle(x, y, ball_radius, GOLD);
        case ball_tier of
          when {1}: (* candy corn stripes *)
            lineTo(x - ball_radius div 2, y + 2, x + ball_radius div 2, y + 2, PALE);
            lineTo(x - ball_radius div 3, y + 6, x + ball_radius div 3, y + 6, ORANGE);
          when {2}: (* eyeball *)
            fcircle(x, y, ball_radius div 2, PALE);
            fcircle(x + 2, y, ball_radius div 4, INK);
            fcircle(x + 3, y - 2, 2, PALE);
          when {3}: (* spider body and legs *)
            fcircle(x, y, ball_radius div 3, INK);
            lineTo(x - 4, y - 4, x - ball_radius + 4, y - ball_radius div 2, INK);
            lineTo(x - 4, y, x - ball_radius + 2, y, INK);
            lineTo(x - 4, y + 4, x - ball_radius + 4, y + ball_radius div 2, INK);
            lineTo(x + 4, y - 4, x + ball_radius - 4, y - ball_radius div 2, INK);
            lineTo(x + 4, y, x + ball_radius - 2, y, INK);
            lineTo(x + 4, y + 4, x + ball_radius - 4, y + ball_radius div 2, INK);
          when {4}: (* bat wings *)
            lineTo(x - ball_radius + 4, y, x - 4, y + 5, INK);
            lineTo(x - 4, y + 5, x, y - 5, INK);
            lineTo(x, y - 5, x + 4, y + 5, INK);
            lineTo(x + 4, y + 5, x + ball_radius - 4, y, INK);
          when {5}: (* ghost eyes *)
            fcircle(x - 5, y - 2, 2, INK);
            fcircle(x + 5, y - 2, 2, INK);
            lineTo(x - 4, y + 6, x + 4, y + 6, PALE);
          when {6}: (* skull eyes *)
            fcircle(x - 6, y - 2, 4, INK);
            fcircle(x + 6, y - 2, 4, INK);
            lineTo(x - 4, y + 7, x + 4, y + 7, INK);
          when {7}: (* potion stopper *)
            rect(x - 4, y - ball_radius + 3, 8, 5, GOLD);
            fcircle(x, y + 3, ball_radius div 3, PALE);
          when {8}: (* cauldron rim *)
            rect(x - ball_radius div 2, y - 5, ball_radius, 6, INK);
            fcircle(x, y - ball_radius div 2, 4, LIME);
          when {9}: (* pumpkin ribs *)
            lineTo(x - ball_radius div 3, y - ball_radius + 4,
                x - ball_radius div 3, y + ball_radius - 4, GOLD);
            lineTo(x + ball_radius div 3, y - ball_radius + 4,
                x + ball_radius div 3, y + ball_radius - 4, GOLD);
            fcircle(x, y, 3, INK);
          when {10}: (* crown *)
            lineTo(x - 12, y - ball_radius + 9, x - 9, y - ball_radius - 3, GOLD);
            lineTo(x - 9, y - ball_radius - 3, x, y - ball_radius + 4, GOLD);
            lineTo(x, y - ball_radius + 4, x + 9, y - ball_radius - 3, GOLD);
            lineTo(x + 9, y - ball_radius - 3, x + 12, y - ball_radius + 9, GOLD);
          otherwise: noop;
        end case;
      end if;
    end for;

    if not started then
      rect(40, 282, 280, 174, NIGHT_LIGHT);
      color(labels, GOLD, NIGHT_LIGHT);
      setPosXY(labels, 69, 304);
      write(labels, "SPOOKY MERGE");
      color(labels, PALE, NIGHT_LIGHT);
      setPosXY(labels, 99, 336);
      write(labels, "Match two spirits");
      setPosXY(labels, 94, 364);
      write(labels, "to make a new one");
      setPosXY(labels, 96, 392);
      write(labels, "SPACE starts and drops");
      setPosXY(labels, 104, 420);
      write(labels, "A / D or arrows aim");
    elsif game.game_over then
      rect(48, 314, 264, 110, NIGHT_LIGHT);
      color(labels, GOLD, NIGHT_LIGHT);
      setPosXY(labels, 120, 337);
      write(labels, "GAME OVER");
      color(labels, PALE, NIGHT_LIGHT);
      setPosXY(labels, 94, 367);
      write(labels, "FINAL SCORE " <& game.score);
      setPosXY(labels, 62, 396);
      write(labels, "Press R or click to play again");
    end if;
    flushGraphic;
  end func;


const func integer: round_seed is func
  result
    var integer: seed is 0;
  local
    var time: moment is time.value;
  begin
    moment := time(NOW);
    seed := timestamp1970(moment) * 1000000 + moment.micro_second;
  end func;


const proc: start_round is func
  begin
    reset_game(game, round_seed);
    started := TRUE;
    drop_pending := FALSE;
    accumulator := 0.0;
    last_time := time(NOW);
  end func;


const proc: process_input is func
  local
    var integer: raw_pointer is 0;
  begin
    raw_pointer := pointerXPos(curr_win);
    if raw_pointer <> last_raw_pointer then
      last_raw_pointer := raw_pointer;
      pointer_x := raw_pointer;
    end if;
    while inputReady(KEYBOARD) do
      command := getc(KEYBOARD);
      case command of
        when {'a', 'A', KEY_LEFT}:
          pointer_x -:= KEY_AIM_STEP;
        when {'d', 'D', KEY_RIGHT}:
          pointer_x +:= KEY_AIM_STEP;
        when {'r', 'R'}:
          start_round;
        when {' ', 's', 'S'}:
          if not started or game.game_over then
            start_round;
          else
            drop_current(game, float(pointer_x));
          end if;
        when {KEY_MOUSE1}:
          if not started or game.game_over then
            start_round;
          else
            drop_pending := TRUE;
          end if;
        when {KEY_CLOSE, KEY_ESC}:
          running := FALSE;
        otherwise: noop;
      end case;
    end while;
    if pointer_x < FIELD_LEFT then
      pointer_x := FIELD_LEFT;
    elsif pointer_x > FIELD_RIGHT then
      pointer_x := FIELD_RIGHT;
    end if;
    if drop_pending and not buttonPressed(KEYBOARD, KEY_MOUSE1) then
      drop_current(game, float(pointer_x));
      drop_pending := FALSE;
    end if;
  end func;


const proc: main is func

  local
    var integer: simulation_step is 0;
  begin
    screen(PLAY_WIDTH, PLAY_HEIGHT);
    selectInput(curr_win, KEY_CLOSE, TRUE);
    # The Emscripten driver reports touch drags only inside a sub window.
    main_window := curr_win;
    curr_win := openSubWindow(main_window, 0, 0, PLAY_WIDTH, PLAY_HEIGHT);
    KEYBOARD := GRAPH_KEYBOARD;
    labels := openPixmapFontFile(curr_win);
    setFont(labels, stdFont14);
    color(labels, PALE, NIGHT);
    startup_arguments := argv(PROGRAM);
    if length(startup_arguments) >= 1 then
      block
        game.best_score := integer(startup_arguments[1]);
      exception
        catch RANGE_ERROR:
          game.best_score := 0;
      end block;
    end if;
    saved_best := game.best_score;
    reset_game(game, round_seed);
    started := FALSE;
    running := TRUE;
    last_raw_pointer := pointerXPos(curr_win);
    last_time := time(NOW);
    while running do
      process_input;
      current_time := time(NOW);
      elapsed := current_time - last_time;
      last_time := current_time;
      frame_time := float(getSeconds(elapsed)) +
          float(getMicroSeconds(elapsed)) / 1000000.0;
      if frame_time < 0.0 or frame_time > MAX_FRAME_TIME then
        frame_time := 0.0;
        accumulator := 0.0;
      elsif started then
        accumulator +:= frame_time;
        simulation_step := 0;
        while accumulator >= FIXED_STEP and simulation_step < MAX_CATCHUP_STEPS do
          step_game(game, FIXED_STEP);
          accumulator -:= FIXED_STEP;
          incr(simulation_step);
        end while;
        if simulation_step = MAX_CATCHUP_STEPS then
          accumulator := 0.0;
        end if;
      end if;
      if game.best_score > saved_best then
        saved_best := game.best_score;
        writeln("SPOOKY_BEST=" <& saved_best);
      end if;
      draw_scene;
      await(time(NOW) + 16000 . MICRO_SECONDS);
    end while;
  end func;
